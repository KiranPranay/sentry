<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sentry">

        <service
            android:name=".service.SentryInteractionService"
            android:label="Sentry"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <!-- WARNING: Service hosting UI but resizing usually applies to Activities. 
                 However, VoiceInteractionSession window behavior is controlled here or in the session config.
                 Since standard attributes might not work on Service tag, we rely on the Session window params.
                 BUT, let's try the PermissionsActivity as a proxy to ensure the app respects it generally 
                 or check if we can apply it to the session window in code. 
                 Actually, windowSoftInputMode in Manifest works for Activities. 
                 For VoiceInteractionSession, we might need code in onCreate/onShow. 
                 Let's add it to the Application tag as a global default attempt or check if there's a specific activity hosting this.
                 Wait, VoiceInteractionSession is a Window. We should set it in SentrySession.kt code.
                 Let's do that instead of Manifest for the Service. -->
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/sentry_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.SentrySessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <service
            android:name=".service.SentryRecognitionService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <activity android:name=".ui.PermissionsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>

    </application>

</manifest>